NODE_ENV=development
PORT=5000

# Database configuration - Option 1: Discrete variables (Recommended for Amazon RDS & Render)
# DB_HOST=your-rds-sqlserver-instance.xxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=1433
# DB_NAME=HotelBooking
# DB_USER=admin
# DB_PASSWORD=your_secure_password
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false

# Database configuration - Option 2: Full Connection String
# Local SQL Server example. Keep this file out of Git and replace placeholders locally.
DATABASE_URL=sqlserver://localhost:1433;database=HotelBooking;user=sa;password=CHANGE_ME;encrypt=false;trustServerCertificate=true;connectionTimeout=15000;socketTimeout=30000;poolTimeout=10;connectionLimit=10

# Amazon RDS for SQL Server production format (configure in Render Environment Secrets, never commit credentials):
# DATABASE_URL=sqlserver://<rds-instance>.<region>.rds.amazonaws.com:1433;database=<database>;user=<user>;password=<secret>;encrypt=true;trustServerCertificate=false;connectionTimeout=15000;socketTimeout=30000;poolTimeout=10;connectionLimit=10
# Production startup requires encryption, certificate validation (trustServerCertificate=false), bounded connection/query/pool timeouts, and a pool cap.

# Production: FRONTEND_URL/CORS_ORIGIN do NOT follow NODE_ENV automatically —
# an operator must set these to the real deployed domain(s) by hand (env.ts
# only checks they use https://, not that they're the correct domain).
# Example for Netlify: https://your-hotel-app.netlify.app
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Set true behind Render reverse proxy / ingress so Express rate-limit keys use its X-Forwarded-For client address.
# Ensure the application is reachable only through that trusted ingress; do not expose a direct bypass port.
TRUST_PROXY=false

# SMTP password-reset delivery. Leave all four credential fields blank only
# for local development; production requires every value below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD= 
SMTP_FROM=

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# How payments and refunds are completed:
#   simulated  (default outside production) no external gateway. "Thanh toán ngay" and "Hủy đặt phòng" finish inside our own
#              backend and are recorded in THANH_TOAN / HOAN_TIEN exactly like real ones; the UI shows a loading animation and
#              then the result. Needs no VNPAY account. VNPAY_* below are ignored.
#   vnpay      the real VNPAY redirect / IPN / refund API (needs the merchant values below).
# Production must choose explicitly (startup fails otherwise): simulating payments there confirms bookings without any money.
# PAYMENT_PROVIDER=simulated
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay-return
VNPAY_IPN_URL=http://localhost:5000/api/payments/vnpay-ipn
PAYMENT_TIMEOUT_MINUTES=15

# Production: set NODE_ENV=production, use HTTPS URLs, real non-placeholder
# secrets, encrypt=true for SQL Server, and non-sandbox VNPAY endpoints.

# Refresh-cookie policy. REQUIRED in production (startup fails without it) because the right value depends on where
# the SPA and the API are hosted:
#   lax   SPA and API on the SAME site (same registrable domain, or one reverse proxy serving both).
#   none  SPA and API on DIFFERENT sites (e.g. Netlify on *.netlify.app and Render on *.onrender.com; forces Secure; needs CORS_ORIGIN = exact Netlify HTTPS origin).
# Outside production it defaults to lax. CORS_ORIGIN/FRONTEND_URL must be exact origins — a wildcard is rejected.
# REFRESH_COOKIE_SAMESITE=none
