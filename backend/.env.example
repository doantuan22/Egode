NODE_ENV=development
PORT=5000

# Production: must include encrypt=true (enforced by env.ts — startup fails otherwise).
DATABASE_URL=sqlserver://localhost:1433;database=HotelBooking;user=sa;password=CHANGE_ME;encrypt=false;trustServerCertificate=true

# Production: FRONTEND_URL/CORS_ORIGIN do NOT follow NODE_ENV automatically —
# an operator must set these to the real deployed domain(s) by hand (env.ts
# only checks they use https://, not that they're the correct domain).
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Set true only when the app is behind a trusted reverse proxy/load balancer
# (affects req.ip, and therefore rate-limiter keying) — does not auto-follow NODE_ENV either.
TRUST_PROXY=false

# SMTP password-reset delivery. Leave all four credential fields blank only
# for local development; production requires every value below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay-return
VNPAY_IPN_URL=http://localhost:5000/api/payments/vnpay-ipn
PAYMENT_TIMEOUT_MINUTES=15

# Production: set NODE_ENV=production, use HTTPS URLs, real non-placeholder
# secrets, encrypt=true for SQL Server, and non-sandbox VNPAY endpoints.

# Refresh-cookie policy. REQUIRED in production (startup fails without it) because the right value depends on where
# the SPA and the API are hosted, which this repo does not decide:
#   lax   SPA and API on the SAME site (same registrable domain, or one reverse proxy serving both).
#   none  SPA and API on DIFFERENT sites (forces Secure; needs CORS_ORIGIN = the SPA's exact https origin).
# Outside production it defaults to lax. CORS_ORIGIN/FRONTEND_URL must be exact origins — a wildcard is rejected.
# REFRESH_COOKIE_SAMESITE=lax
