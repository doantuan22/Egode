{
  "name": "hotel-booking-backend",
  "version": "1.0.0",
  "description": "Hotel Booking API - Node.js Express TypeScript",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "seed:discovery": "tsx prisma/seed-discovery.ts",
    "seed:demo:images": "tsx prisma/demo-seed/upload-images.ts",
    "seed:demo:sql": "tsx prisma/demo-seed/build-sql.ts"
  },
  "keywords": [
    "hotel-booking",
    "express",
    "typescript",
    "prisma",
    "sql-server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
