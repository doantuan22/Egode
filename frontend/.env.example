VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_ENV=development

# Production example:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_APP_ENV=production

# Cookie / CORS (see backend/.env.example, REFRESH_COOKIE_SAMESITE):
# - API on the SAME site as the SPA (or one reverse proxy serving both, "/api" relative): leave VITE_API_BASE_URL unset
#   in production, or set it to that same-site API origin; the backend uses REFRESH_COOKIE_SAMESITE=lax.
# - API on ANOTHER site: set VITE_API_BASE_URL to the API origin; the backend must use REFRESH_COOKIE_SAMESITE=none
#   and CORS_ORIGIN=<this SPA's exact https origin>. Every request already sends credentials: "include".
# - Dev: leaving VITE_API_BASE_URL unset uses the Vite proxy (/api -> http://localhost:5000, override with VITE_DEV_API_TARGET).

# Simulated payments/refunds: how long (ms) the processing animation stays on screen at least. Default 2600.
# VITE_SIMULATION_DELAY_MS=2600
