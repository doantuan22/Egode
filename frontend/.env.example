# Development: may point straight at the local API, or leave unset to use the Vite /api proxy.
VITE_API_BASE_URL=http://localhost:5000/api

# Production build requirement (configure in Cloudflare Pages; replace with the actual backend URL):
# VITE_API_BASE_URL=https://<northflank-api-host>/api

# Cookie / CORS (see backend/.env.example, REFRESH_COOKIE_SAMESITE):
# - Same-site custom domains: use the backend HTTPS URL here; the backend uses REFRESH_COOKIE_SAMESITE=lax.
# - Different sites (for example *.pages.dev and a Northflank domain): set the backend HTTPS URL here and use
#   REFRESH_COOKIE_SAMESITE=none; the backend must set CORS_ORIGIN to this SPA's exact HTTPS origin.
# - This repository's Cloudflare Pages deployment is cross-origin by default; do not omit this variable.
# - Dev: leaving VITE_API_BASE_URL unset uses the Vite proxy (/api -> http://localhost:5000, override with VITE_DEV_API_TARGET).

# Simulated payments/refunds: how long (ms) the processing animation stays on screen at least. Default 2600.
# VITE_SIMULATION_DELAY_MS=2600
